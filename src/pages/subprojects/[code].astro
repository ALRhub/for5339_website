---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Illustration from '../../components/Illustration.astro';
import GripperResult from '../../components/GripperResult.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import NewsList from '../../components/NewsList.astro';
import SubprojectNav from '../../components/SubprojectNav.astro';
import { byName, getMemberKeys, getNews, getPeople, getPublications, getSubprojects, publicationHref, venueShort } from '../../lib/data';

export async function getStaticPaths() {
  const subprojects = await getSubprojects();
  return subprojects.map((entry, i) => ({
    params: { code: entry.data.code.toLowerCase() },
    props: {
      entry,
      prev: subprojects[(i - 1 + subprojects.length) % subprojects.length],
      next: subprojects[(i + 1) % subprojects.length],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const s = entry.data;
const { Content } = await render(entry);

const people = await getPeople();
const byId = Object.fromEntries(people.map((p) => [p.id, p]));
const person = (id: string) => {
  const p = byId[id];
  if (!p) throw new Error(`Subproject ${s.code}: unknown person id "${id}"`);
  return p;
};
const pis = s.pis.map(person);
// Principal investigators of other subprojects who also work in this one, listed with their role.
const alsoPis = people.filter((p) => p.data.group === 'pi' && p.data.subprojects.includes(s.code) && !s.pis.includes(p.id)).sort(byName);
const researchers = people.filter((p) => p.data.group === 'researcher' && p.data.subprojects.includes(s.code)).sort(byName);
const alumni = people.filter((p) => p.data.group === 'alumni' && p.data.subprojects.includes(s.code)).sort(byName);
const allPubs = await getPublications();
const pubById = new Map(allPubs.map((p) => [p.id, p]));
const pubs = allPubs.filter((p) => p.data.subprojects.includes(s.code));
const members = await getMemberKeys();

const papers = (ids: string[]) =>
  ids.map((id) => {
    const p = pubById.get(id);
    if (!p) throw new Error(`Subproject ${s.code}: unknown publication id "${id}"`);
    return p;
  });
// Work packages; each figure also gets a large version for the viewer.
const workPackages = await Promise.all(
  s.workPackages.map(async (w) => ({
    ...w,
    papers: papers(w.papers),
    large: w.figure ? await getImage({ src: w.figure.src, width: Math.min(1600, w.figure.src.width), format: 'webp' }) : undefined,
  })),
);
const contributions = s.contributions.map((c) => ({ ...c, papers: papers(c.papers) }));
const showResult = s.code === 'M3';
const events = s.code === 'C' ? (await getNews()).filter((n) => ['event', 'talk'].includes(n.data.kind)) : [];
const name = (p: (typeof people)[number]) => (p.data.title ? `${p.data.title} ${p.data.name}` : p.data.name);
---

<Base title={`${s.code} ${s.short}`} description={s.summary}>
  <SubprojectNav current={s.code} />

  <header class="page-head">
    <div class="wrap">
      <p class="label"><span class="big-code">{s.code}</span> {s.verb}</p>
      <h1>{s.title}</h1>
      <p class="lead">{s.summary}</p>
    </div>
  </header>

  {
    s.illustration && (
      <section class="wrap illo-wrap">
        <Illustration
          name={s.illustration.name}
          ratio="16 / 7.5"
          ratioSmall="4 / 3.6"
          label={s.illustration.label}
          caption={s.illustration.caption}
          class="sp-illo"
        />
      </section>
    )
  }

  <section class="section" aria-labelledby="contrib-title">
    <div class="wrap">
      {
        workPackages.length > 0 ? (
          <Fragment>
            <h2 id="contrib-title" class="block-title">Work packages</h2>
            <p class="wp-intro">Results of the first funding phase, by work package.</p>
            <ol class="wps">
              {workPackages.map((w) => (
                <li class="wp">
                  <h3 class="wp-head">
                    <span class="wp-code">{w.code}</span> {w.title}
                  </h3>
                  <div class="wp-body">
                    <p>{w.text}</p>
                    {w.figure && w.large && (
                      <figure class="wp-figure">
                        <a class="zoom" href={w.large.src} data-caption={`${w.figure.caption} Figure: ${w.figure.credit}.`}>
                          <Image src={w.figure.src} alt={w.figure.alt} widths={[480, 800, 1200]} sizes="(min-width: 78rem) 43rem, (min-width: 60rem) 56vw, 92vw" />
                          <span class="visually-hidden">Enlarge figure</span>
                        </a>
                        <figcaption>
                          {w.figure.caption} Figure: {w.figure.credit}.
                        </figcaption>
                      </figure>
                    )}
                  </div>
                  {w.papers.length > 0 && (
                    <div class="wp-refs">
                      <p class="refs-label">Publications</p>
                      <ul class="refs">
                        {w.papers.map((p) => (
                          <li>
                            <p class="ref-title">{publicationHref(p.data) ? <a href={publicationHref(p.data)}>{p.data.title}</a> : p.data.title}</p>
                            <p class="ref-venue">{venueShort(p.data)}</p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </Fragment>
        ) : (
          <Fragment>
            <h2 id="contrib-title" class="block-title">What we do</h2>
            <ol class="contribs">
              {contributions.map((c) => (
                <li>
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                  {c.photos.length > 0 && (
                    <figure class="contrib-photos">
                      <div class="photo-row">
                        {c.photos.map((ph) => (
                          <Image src={ph.src} alt={ph.alt} widths={[320, 520]} sizes="(min-width: 60rem) 16rem, 44vw" />
                        ))}
                      </div>
                      {c.credit && <figcaption>{c.credit}</figcaption>}
                    </figure>
                  )}
                  {c.papers.length > 0 && (
                    <ul class="refs">
                      {c.papers.map((p) => (
                        <li>
                          <p class="ref-title">{publicationHref(p.data) ? <a href={publicationHref(p.data)}>{p.data.title}</a> : p.data.title}</p>
                          <p class="ref-venue">{venueShort(p.data)}</p>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </Fragment>
        )
      }
      {
        showResult && (
          <div class="result-wrap">
            <h3 class="result-title">A result, jointly with M1, T1 and T2</h3>
            <GripperResult />
          </div>
        )
      }
    </div>
  </section>

  <dialog class="viewer" aria-label="Enlarged figure">
    <form method="dialog">
      <button class="viewer-close" aria-label="Close">Close</button>
    </form>
    <img alt="" />
    <p class="viewer-caption"></p>
  </dialog>

  <section class="section section--grey" aria-labelledby="about-title">
    <div class="wrap about">
      <div>
        <h2 id="about-title" class="block-title">About the subproject</h2>
        <div class="prose body">
          <Content />
        </div>
      </div>
      <dl class="facts">
        <div>
          <dt>Principal investigators</dt>
          <dd>
            <ul>{pis.map((p) => <li>{p.data.url ? <a href={p.data.url}>{name(p)}</a> : name(p)}</li>)}</ul>
          </dd>
        </div>
        {
          alsoPis.map((p) => (
            <div>
              <dt>{p.data.role ?? 'Team'}</dt>
              <dd>
                <ul>
                  <li>{p.data.url ? <a href={p.data.url}>{name(p)}</a> : name(p)}</li>
                </ul>
              </dd>
            </div>
          ))
        }
        {
          researchers.length > 0 && (
            <div>
              <dt>Researchers</dt>
              <dd>
                <ul>{researchers.map((p) => <li>{name(p)}</li>)}</ul>
              </dd>
            </div>
          )
        }
        {
          alumni.length > 0 && (
            <div>
              <dt>Former members</dt>
              <dd>
                <ul>{alumni.map((p) => <li>{name(p)}</li>)}</ul>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Host institute</dt>
          <dd>{s.host}</dd>
        </div>
        <div>
          <dd><a class="text-link" href={`/team/?sp=${s.code}`}>People in {s.code}</a></dd>
        </div>
      </dl>
    </div>
  </section>

  {
    pubs.length > 0 && (
      <section class="section" aria-labelledby="pub-title">
        <div class="wrap">
          <h2 id="pub-title" class="block-title">
            Publications <span class="count">{pubs.length}</span>
          </h2>
          <ul class="pub-list">
            {pubs.map((p) => <PublicationItem pub={p} members={members} />)}
          </ul>
        </div>
      </section>
    )
  }

  {
    events.length > 0 && (
      <section class="section" aria-labelledby="events-title">
        <div class="wrap">
          <h2 id="events-title" class="block-title">Events</h2>
          <NewsList items={events} />
        </div>
      </section>
    )
  }

  <nav class="pager" aria-label="Other subprojects">
    <div class="wrap pager-inner">
      <a href={`/subprojects/${prev.data.code.toLowerCase()}/`} rel="prev">
        <span class="dir">Previous</span>
        <span class="to"><span class="code">{prev.data.code}</span> {prev.data.verb}</span>
      </a>
      <a href="/subprojects/" class="all">All subprojects</a>
      <a href={`/subprojects/${next.data.code.toLowerCase()}/`} rel="next" class="next">
        <span class="dir">Next</span>
        <span class="to"><span class="code">{next.data.code}</span> {next.data.verb}</span>
      </a>
    </div>
  </nav>
</Base>

<script>
  // Figures open in a viewer; without JavaScript the link opens the large image itself.
  const viewer = document.querySelector<HTMLDialogElement>('dialog.viewer');
  if (viewer) {
    const img = viewer.querySelector('img')!;
    const caption = viewer.querySelector<HTMLElement>('.viewer-caption')!;
    document.querySelectorAll<HTMLAnchorElement>('a.zoom').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        img.src = a.href;
        img.alt = a.querySelector('img')?.alt ?? '';
        caption.textContent = a.dataset.caption ?? '';
        viewer.showModal();
      }),
    );
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer) viewer.close();
    });
  }
</script>

<style>
  .label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .big-code {
    font-size: 1.5rem;
    font-weight: 600;
    font-stretch: 90%;
    color: var(--link);
  }

  .page-head h1 {
    max-width: 26ch;
    font-size: var(--step-4);
  }

  .illo-wrap :global(.sp-illo .stage) {
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .block-title {
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    font-size: var(--step-3);
  }

  .contribs {
    display: grid;
    gap: 2.5rem 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: c;
  }

  @media (min-width: 52rem) {
    .contribs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contribs > li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .contribs h3 {
    margin-bottom: 0.5rem;
  }

  .contribs > li > p {
    color: var(--ink-2);
    max-width: 52ch;
  }

  /* A paper: title as in the publication list, venue below */
  .refs {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contrib-photos {
    margin: 1rem 0 0;
  }

  .photo-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .photo-row :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: calc(var(--radius) - 2px);
  }

  .contrib-photos figcaption {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .contribs .refs {
    margin-top: 1rem;
  }

  .ref-title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .ref-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .ref-title a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .ref-venue {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    font-style: italic;
    color: var(--ink-3);
  }

  .wp-intro {
    margin: -0.75rem 0 1.75rem;
    color: var(--ink-3);
  }

  .wps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  /* Every work package has the same layout: the title across the top, then the text and any
     figure, then its publications, which take a column of their own on wide screens */
  .wp {
    display: grid;
    gap: 0.75rem 3rem;
    padding-block: 2.25rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .wp > * {
    min-width: 0;
  }

  .wp-head {
    line-height: 1.3;
  }

  .wp-code {
    margin-right: 0.3rem;
    font-weight: 600;
    font-stretch: 92%;
    color: var(--link);
  }

  .wp-body > p {
    max-width: 62ch;
    color: var(--ink-2);
  }

  .wp-refs {
    margin-top: 0.75rem;
  }

  .refs-label {
    margin-bottom: 0.6rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  @media (min-width: 60rem) {
    .wp {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }

    .wp-head {
      grid-column: 1 / -1;
    }

    .wp-refs {
      grid-column: 2;
      margin-top: 0;
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
  }

  .wp-figure {
    margin: 1.5rem 0 0;
  }

  .zoom {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    cursor: zoom-in;
  }

  .zoom :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .wp-figure figcaption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .viewer {
    max-width: min(96vw, 110rem);
    max-height: 94vh;
    padding: 1rem 1rem 1.25rem;
    border: 0;
    border-radius: var(--radius);
    background: #fff;
  }

  .viewer::backdrop {
    background: rgb(20 20 20 / 0.72);
  }

  .viewer img {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    margin-inline: auto;
    object-fit: contain;
  }

  .viewer form {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.5rem;
  }

  .viewer-close {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .viewer-caption {
    max-width: 90ch;
    margin: 0.75rem auto 0;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .result-wrap {
    margin-top: clamp(3rem, 2.5rem + 2vw, 4rem);
    max-width: 52rem;
  }

  .result-title {
    margin-bottom: 1.25rem;
  }

  .about {
    display: grid;
    gap: 2.5rem 4rem;
  }

  @media (min-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
  }

  .body {
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .facts dt {
    margin-bottom: 0.3rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .facts dd {
    margin: 0;
    line-height: 1.45;
  }

  .facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li + li {
    margin-top: 0.25rem;
  }

  .count {
    margin-left: 0.3rem;
    font-size: 0.6em;
    font-weight: 500;
    color: var(--ink-3);
  }

  .pub-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .pager {
    border-top: 1px solid var(--line);
  }

  .pager-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .pager a {
    color: var(--ink);
    text-decoration: none;
  }

  .pager a[rel] {
    display: grid;
    gap: 0.1rem;
  }

  .pager a:hover .to,
  .pager .all:hover {
    text-decoration: underline;
  }

  .pager .next {
    text-align: right;
  }

  .all {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2) !important;
  }

  .dir {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .to {
    font-weight: 500;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { nav } from '../config';
---

<Base title="Page not found">
  <section class="section">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lead">
        This page does not exist, or it moved when the website was redesigned. These pages are a good place to continue.
      </p>
      <ul>
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--step-4);
  }

  .lead {
    margin-top: 1rem;
    max-width: 52ch;
  }

  ul {
    margin-top: 2rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
</style>

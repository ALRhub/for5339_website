---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getNews, isoDate } from '../../lib/data';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const n = entry.data;
const { Content } = await render(entry);
---

<Base title={n.title} description={n.summary}>
  <article>
    <header class="page-head">
      <div class="wrap">
        <p class="crumbs"><a href="/news/">News</a></p>
        <h1>{n.title}</h1>
        <p class="date"><time datetime={isoDate(n.date, n.precision)}>{formatDate(n.date, n.precision)}</time></p>
        <p class="lead">{n.summary}</p>
      </div>
    </header>
    <div class="section section--tight">
      <div class="wrap prose">
        <Content />
        {
          n.link && (
            <p>
              <a href={n.link.href}>{n.link.label}</a>
            </p>
          )
        }
        <p class="back"><a href="/news/">All news</a></p>
      </div>
    </div>
  </article>
</Base>

<style>
  .crumbs {
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .date {
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .back {
    margin-top: 2.5rem;
    font-weight: 600;
  }
</style>

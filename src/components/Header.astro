---
import { Image } from 'astro:assets';
import kitLogo from '../assets/brand/kit-logo-en.svg';
import dfgLogo from '../assets/brand/dfg-logo.png';
import Logo from './Logo.astro';
import { nav, site } from '../config';
import { getSubprojects } from '../lib/data';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
// "Subprojects" opens a list of all subprojects (on hover or focus on wide screens, inline in the phone menu).
const subprojects = await getSubprojects();
const subHref = (code: string) => `/subprojects/${code.toLowerCase()}/`;
---

<header class="site-header">
  <div class="wrap bar">
    <div class="brand">
      <a class="kit" href="https://www.kit.edu/english/" aria-label="Karlsruhe Institute of Technology">
        <img src={kitLogo.src} width="88" height="40" alt="" />
      </a>
      <a class="dfg" href="https://www.dfg.de/en" aria-label="Deutsche Forschungsgemeinschaft (DFG, German Research Foundation)">
        <Image src={dfgLogo} height={24} densities={[1, 2]} format="png" alt="" />
      </a>
      <a class="unit" href="/" aria-label={`MATURE.AI, ${site.name}, home`}>
        <Logo />
      </a>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      Menu
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) =>
            item.href === '/subprojects/' ? (
              <li class="has-sub">
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                  <span class="chevron" aria-hidden="true" />
                </a>
                <div class="sub-panel">
                  <ul class="sub-list" aria-label="Subprojects">
                    {subprojects.map((s) => (
                      <li>
                        <a href={subHref(s.data.code)} aria-current={path.startsWith(subHref(s.data.code)) ? 'page' : undefined}>
                          <span class="sub-code">{s.data.code}</span>
                          <span class="sub-text">
                            <span class="sub-name">{s.data.short}</span>
                            <span class="sub-tag">{s.data.tagline}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="sub-all" href="/subprojects/">How the subprojects work together</a>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
  });
  // the subproject list opens on hover or focus; Escape closes it until the pointer or focus leaves
  const sub = header?.querySelector<HTMLElement>('.has-sub');
  const reset = () => sub?.classList.remove('is-dismissed');
  sub?.addEventListener('mouseleave', reset);
  sub?.addEventListener('focusout', (e) => {
    if (!sub.contains(e.relatedTarget as Node | null)) reset();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (sub && (sub.matches(':hover') || sub.contains(document.activeElement)) && !header?.classList.contains('is-open')) {
      sub.classList.add('is-dismissed');
      sub.querySelector<HTMLElement>(':scope > a')?.focus();
      return;
    }
    if (header?.classList.contains('is-open')) {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    /* solid white: the DFG allows its logo only on white or a plain colour */
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  .kit img {
    width: 88px;
    height: auto;
  }

  /* The DFG logo, unaltered. Its clear zone, the height of the DFG letters (21px here), is kept on every
     side: the gaps to the KIT logo and to the divider, and the header height. Phones show it in the footer. */
  .kit,
  .dfg {
    flex-shrink: 0;
  }

  .dfg {
    display: none;
    margin-inline: 0.5rem;
  }

  .dfg :global(img) {
    display: block;
    width: auto;
    height: 24px;
  }

  @media (min-width: 45rem) {
    .dfg {
      display: block;
    }
  }

  .unit {
    --logo-h: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-2);
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.9688rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: 999px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav a:hover {
    color: var(--ink);
    background: var(--bg-2);
  }

  .nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--bg-2);
  }

  /* ---- subproject list under "Subprojects" */
  .has-sub {
    position: relative;
  }

  .chevron {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.2rem) rotate(45deg);
    transition: transform 0.2s var(--ease);
  }

  .has-sub:is(:hover, :focus-within):not(.is-dismissed) .chevron {
    transform: translateY(0.05rem) rotate(225deg);
  }

  .sub-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(36rem, 92vw);
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.4rem);
    transition: opacity 0.15s ease, transform 0.15s var(--ease), visibility 0.15s;
  }

  /* bridges the gap between the menu item and the panel, so the pointer can travel into it */
  .sub-panel::before {
    content: '';
    position: absolute;
    inset: -0.75rem 0 100% 0;
  }

  .has-sub:is(:hover, :focus-within):not(.is-dismissed) .sub-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0.6rem);
  }

  .nav .sub-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav .sub-list a {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.6rem 0.7rem;
    border-radius: calc(var(--radius) - 2px);
    font-size: 0.9375rem;
  }

  .nav .sub-list a:hover,
  .nav .sub-list a[aria-current='page'] {
    background: var(--bg-2);
  }

  .sub-code {
    flex: none;
    min-width: 1.9rem;
    font-weight: 700;
    color: var(--link);
  }

  .sub-text {
    display: grid;
    gap: 0.1rem;
  }

  .sub-name {
    font-weight: 600;
    color: var(--ink);
  }

  .sub-tag {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-3);
  }

  .nav .sub-all {
    display: block;
    margin-top: 0.75rem;
    padding: 0.75rem 0.7rem 0.15rem;
    border-top: 1px solid var(--line);
    border-radius: 0;
    font-size: 0.875rem;
    color: var(--link);
  }

  .nav .sub-all:hover {
    background: none;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .sub-panel,
    .chevron {
      transition: none;
    }
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 15px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.2s var(--ease), opacity 0.2s;
  }

  .menu-icon {
    position: relative;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-icon::before {
    top: -5px;
  }

  .menu-icon::after {
    top: 5px;
  }

  /* below 74rem the logos and the full menu do not fit on one row */
  @media (max-width: 74rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 32px -24px rgb(0 0 0 / 0.3);
    }

    .site-header.is-open .nav {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
    }

    .nav a {
      padding: 0.85rem 0.25rem;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
      font-size: 1.0625rem;
    }

    .nav li:last-child a {
      border-bottom: 0;
    }

    /* in the phone menu the subprojects are listed inline under "Subprojects" */
    .chevron {
      display: none;
    }

    .sub-panel,
    .has-sub:is(:hover, :focus-within):not(.is-dismissed) .sub-panel {
      position: static;
      width: auto;
      padding: 0.25rem 0 0.75rem;
      border: 0;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: none;
    }

    .sub-panel::before {
      display: none;
    }

    .has-sub > a {
      border-bottom: 0;
    }

    .nav .sub-list {
      flex-direction: unset;
      padding: 0;
      gap: 0 1rem;
    }

    .nav .sub-list a {
      padding: 0.45rem 0.25rem;
      border: 0;
      font-size: 0.9375rem;
    }

    .sub-tag,
    .nav .sub-all {
      display: none;
    }

    .nav a[aria-current='page'] {
      background: none;
      color: var(--link);
    }

    .site-header.is-open .menu-icon {
      background: transparent;
    }

    .site-header.is-open .menu-icon::before {
      transform: translateY(5px) rotate(45deg);
    }

    .site-header.is-open .menu-icon::after {
      transform: translateY(-5px) rotate(-45deg);
    }
  }

  @media (max-width: 30rem) {
    .unit { --logo-h: 30px; }
  }

  @media (max-width: 26rem) {
    .bar { gap: 0.5rem; }
    .brand { gap: 0.5rem; }
    .kit img { width: 60px; }
    .unit { padding-left: 0.55rem; --logo-h: 30px; }
    .menu-toggle { padding-inline: 0.65rem; font-size: 0.875rem; }
  }

  @media (max-width: 23rem) {
    .brand { gap: 0.4rem; }
    .kit img { width: 52px; }
    .unit { padding-left: 0.4rem; --logo-h: 26px; }
    .menu-toggle { width: 2.75rem; height: 2.75rem; padding: 0; justify-content: center; gap: 0; font-size: 0; }
  }
</style>
